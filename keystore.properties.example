# Copy to keystore.properties (gitignored) and fill in your own values.
# Never commit keystore.properties or the keystore file itself.
# storeFile is resolved relative to the repository root (absolute paths also work);
# keeping the keystore outside the repository is safest.
storeFile=../glitch-release.jks
storePassword=CHANGE_ME
keyAlias=glitch
keyPassword=CHANGE_ME
