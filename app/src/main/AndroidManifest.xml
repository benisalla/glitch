<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Narrow package visibility: only activities that answer the standard
      launcher intent become visible. No QUERY_ALL_PACKAGES, no INTERNET,
      no other permissions.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Glitch">
        <!--
          singleTask: one menu instance. Launching Glitch again while it is in the background
          reaches that instance (onNewIntent), which starts a new session even when onStop
          has not arrived yet. Glitch is not a home app: no HOME intent filter.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Shuffled apps widget (approved 2026-10-13). It lives on the phone's own home screen;
          Glitch stays a normal app. No permissions: the service is protected by the system's
          BIND_REMOTEVIEWS so only the widget host can bind it.
        -->
        <receiver
            android:name=".widget.ShuffleWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/shuffle_widget_info" />
        </receiver>

        <service
            android:name=".widget.ShuffleWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!--
          Invisible step from a widget tap to the app: opens it, asks the widget to reshuffle,
          finishes at once. Own empty task affinity so Glitch's menu never comes to the front,
          and no entry in Recents.
        -->
        <activity
            android:name=".widget.LaunchTrampolineActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Glitch.Trampoline" />
    </application>
</manifest>
