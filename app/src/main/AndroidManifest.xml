<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Narrow package visibility: only activities that answer the standard
      launcher intent become visible. No QUERY_ALL_PACKAGES, no INTERNET,
      no other permissions.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Glitch">
        <!--
          Launcher attributes, as in AOSP Launcher3:
          - singleTask: one instance; Home presses reach it through onNewIntent.
          - stateNotNeeded: the system may restart it without saved state (all state is in
            the ViewModel and SharedPreferences), which home apps need to come back fast.
          - clearTaskOnLaunch: nothing stacks on top of the home task.
          Not excludeFromRecents: the system already keeps the home task out of Recents,
          and as a normal app Glitch should stay in Recents.
        -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Optional: lets the user choose Glitch as the default home app. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
